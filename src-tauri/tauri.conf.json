{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RuT0DataKit",
  "version": "1.0.0",
  "identifier": "com.rut0.datakit",
  "build": {
    "beforeDevCommand": "pnpm --prefix ../frontend run dev",
    "beforeBuildCommand": "pnpm --prefix ../frontend run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "RuT0DataKit",
        "width": 1280,
        "height": 800,
        "minWidth": 1024,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": "",
      "dialog": false
    }
  }
}
